# ==============================================================================
# PakistanTravel.Agency Environment Variables Configuration
# ==============================================================================

# Database Connection (Neon Serverless PostgreSQL recommended for Vercel)
# DATABASE_URL should use connection pooling for Next.js serverless functions (pgbouncer: true / ?sslmode=require)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth Authentication & Session Security
NEXTAUTH_URL="https://pakistantravel-agency.vercel.app"
NEXTAUTH_SECRET="generate-a-strong-32-byte-hex-or-base64-secret"

# Public Site URL (Used for Canonical URLs, OpenGraph, hreflang, and Sitemap)
NEXT_PUBLIC_APP_URL="https://pakistantravel-agency.vercel.app"

# OAuth Providers (Optional - leave empty if not configured)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Cloudinary Media Storage (For listing photos, hotel galleries, operator documents)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

# Payment Gateways & Webhooks (Verify actual merchant credentials before activating)
PAYMENT_WEBHOOK_SECRET="secure-webhook-hmac-secret-for-jazzcash-easypaisa"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Local PK Gateways (JazzCash / EasyPaisa / Bank Transfer)
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""

# Email Notifications (Resend / SMTP)
RESEND_API_KEY=""
