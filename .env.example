# ==============================================================================
# PakistanTravel.Agency Environment Variables Configuration (.env.example)
# Use placeholder values only. NEVER commit real secrets to source control.
# ==============================================================================

# Database Connection (Neon Serverless PostgreSQL)
# DATABASE_URL should use connection pooling for Next.js serverless functions (pgbouncer: true / ?sslmode=require)
DATABASE_URL="postgresql://placeholder_user:placeholder_pass@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://placeholder_user:placeholder_pass@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://placeholder_user:placeholder_pass@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
TEST_DATABASE_URL="postgresql://placeholder_user:placeholder_pass@ep-test-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth Authentication & Session Security (Minimum 32 random characters)
NEXTAUTH_URL="https://www.pakistantravel.agency"
NEXTAUTH_SECRET="generate-a-strong-32-byte-hex-or-base64-secret-min-32-chars"

# Public Site URL (Used for Canonical URLs, OpenGraph, and Sitemap)
NEXT_PUBLIC_SITE_URL="https://www.pakistantravel.agency"
NEXT_PUBLIC_APP_URL="https://www.pakistantravel.agency"
NEXT_PUBLIC_COMMISSION_PERCENT="10"

# Application-Level AES-256-GCM Field Encryption Keys (Minimum 32 characters)
FIELD_ENCRYPTION_KEY="placeholder-32-byte-aes-gcm-field-encryption-key"
TWO_FACTOR_ENCRYPTION_KEY="placeholder-32-byte-aes-gcm-encryption-key-here"

# Cron Outbox Worker Secret
CRON_SECRET="placeholder-cron-worker-secret-token"

# OAuth Providers (Optional - leave empty if not configured; restricted to CUSTOMER role)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Cloudinary Media Storage (For tour package photos and operator verification documents)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

# Payment Gateways & Webhooks (Verify actual merchant credentials before activating)
PAYMENT_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Local PK Gateways (JazzCash / EasyPaisa / Bank Transfer)
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""

# Email Notifications (SMTP / Resend)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="notifications@pakistantravel.agency"
SMTP_PASSWORD=""
SMTP_FROM="PakistanTravel.Agency <notifications@pakistantravel.agency>"
SUPPORT_EMAIL="support@pakistantravel.agency"
ADMIN_ALERT_EMAIL="admin@pakistantravel.agency"
RESEND_API_KEY=""

# AI Travel Assistant Chatbot (Anthropic / OpenAI / Groq)
CHAT_PROVIDER="anthropic"
CHAT_MODEL="claude-3-5-sonnet-20241022"
CHAT_API_KEY=""
