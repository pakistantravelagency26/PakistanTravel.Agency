datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  VERIFIED
  SUSPENDED
  REJECTED
}

enum ListingType {
  HOTEL
  TOUR
  ACTIVITY
  RENTAL
}

enum ListingStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_VENDOR
  COMPLETED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  STRIPE
  JAZZCASH
  EASYPAISA
  CASH_ON_ARRIVAL
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

// --------------------------------------------------------
// USERS & VENDORS
// --------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  phone         String?   @unique
  passwordHash  String?
  image         String?
  role          Role      @default(CUSTOMER)
  staffRole     String?   @default("SUPER_ADMIN") // SUPER_ADMIN | BOOKINGS_MANAGER | BILLING_FINANCE | LISTING_MODERATOR
  permissions   String?   @default("ALL") // Comma-separated: "BOOKINGS,FINANCE,LISTINGS,VENDORS,DESTINATIONS,COUPONS,TEAM" or "ALL"
  tokenVersion  Int       @default(1) // Incremented on password reset to invalidate all existing sessions
  // Two-Factor Authentication (2FA / TOTP)
  twoFactorEnabled       Boolean   @default(false)
  twoFactorSecret        String?   // AES-256-GCM encrypted base32 secret
  twoFactorRecoveryCodes String?   @db.Text // JSON string array of SHA-256 hashed recovery codes
  twoFactorPendingSecret String?   // AES-256-GCM encrypted secret pending initial verification
  twoFactorEnrolledAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vendorProfile Vendor?
  bookings      Booking[]
  reviews       Review[]
  wishlists     Wishlist[]
  notifications Notification[]

  @@index([email])
  @@index([role])
}

model Vendor {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  cnicOrTaxNumber String?
  phone           String
  whatsapp        String?
  address         String?
  city            String
  status          VendorStatus @default(PENDING)
  commissionRate  Float        @default(12.0)
  bankDetails     Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  listings        Listing[]
  payouts         Payout[]

  @@index([status])
}

// --------------------------------------------------------
// TAXONOMY: CATEGORIES & DESTINATIONS
// --------------------------------------------------------

model Destination {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  province    String
  description String?   @db.Text
  image       String
  isFeatured  Boolean   @default(false)
  listings    Listing[]

  @@index([slug])
  @@index([isFeatured])
}

model Category {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  icon        String?
  type        ListingType
  listings    Listing[]

  @@index([slug])
}

// --------------------------------------------------------
// LISTINGS & SUB-UNITS (ROOMS / PACKAGES)
// --------------------------------------------------------

model Listing {
  id                  String        @id @default(uuid())
  vendorId            String
  vendor              Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  title               String
  slug                String        @unique
  description         String        @db.Text
  type                ListingType
  status              ListingStatus @default(DRAFT)
  destinationId       String
  destination         Destination   @relation(fields: [destinationId], references: [id])
  categoryId          String
  category            Category      @relation(fields: [categoryId], references: [id])
  
  address             String
  city                String
  latitude            Float?
  longitude           Float?

  photos              String[]
  amenities           String[]
  cancellationPolicy  String        @db.Text
  freeCancellationDays Int          @default(1)

  durationDays        Int?          @default(1)
  durationNights      Int?          @default(0)
  singleSupplement    Float?        @default(0.0)
  depositPercent      Float?        @default(25.0)

  vendorPrice         Float?
  basePrice           Decimal       @db.Decimal(10, 2)
  commissionRate      Float?        @default(12.0)
  avgRating           Float         @default(0.0)
  totalReviews        Int           @default(0)
  isFeatured          Boolean       @default(false)

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  units               ListingUnit[]
  departures          Departure[]
  reviews             Review[]
  wishlists           Wishlist[]
  bookings            Booking[]

  @@index([slug])
  @@index([type, status])
  @@index([destinationId])
  @@index([categoryId])
  @@index([basePrice])
  @@index([avgRating])
}

model ListingUnit {
  id            String         @id @default(uuid())
  listingId     String
  listing       Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  title         String
  description   String?        @db.Text
  maxGuests     Int            @default(2)
  totalQuantity Int            @default(1)
  basePrice     Decimal        @db.Decimal(10, 2)
  photos        String[]
  amenities     String[]

  availability  Availability[]
  pricingRules  PricingRule[]
  bookings      Booking[]

  @@index([listingId])
}

// --------------------------------------------------------
// INVENTORY, AVAILABILITY & SEASONAL PRICING
// --------------------------------------------------------

model Availability {
  id              String      @id @default(uuid())
  unitId          String
  unit            ListingUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  date            DateTime    @db.Date
  availableCount  Int
  isBlocked       Boolean     @default(false)

  @@unique([unitId, date])
  @@index([unitId, date])
}

model PricingRule {
  id          String      @id @default(uuid())
  unitId      String
  unit        ListingUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  customPrice Decimal     @db.Decimal(10, 2)
  reason      String?

  @@index([unitId, startDate, endDate])
}

// --------------------------------------------------------
// BOOKINGS & TRANSACTIONS
// --------------------------------------------------------

model Booking {
  id              String        @id @default(uuid())
  bookingNumber   String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  listingId       String
  listing         Listing       @relation(fields: [listingId], references: [id])
  unitId          String
  unit            ListingUnit   @relation(fields: [unitId], references: [id])
  
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  guestsCount     Int           @default(1)
  unitsCount      Int           @default(1)

  totalAmount     Decimal       @db.Decimal(10, 2)
  vendorEarnings  Decimal       @db.Decimal(10, 2)
  platformFee     Decimal       @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0.0) @db.Decimal(10, 2)

  status          BookingStatus @default(PENDING_PAYMENT)
  
  departureId     String?
  departure       Departure?    @relation(fields: [departureId], references: [id])
  depositAmount   Decimal?      @default(0.0) @db.Decimal(10, 2)
  balanceDue      Decimal?      @default(0.0) @db.Decimal(10, 2)
  isSoloTraveler  Boolean       @default(false)
  singleSupplement Decimal?     @default(0.0) @db.Decimal(10, 2)

  guestName       String
  guestEmail      String
  guestPhone      String
  specialRequests String?       @db.Text

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payment         Payment?
  couponId        String?
  coupon          Coupon?       @relation(fields: [couponId], references: [id])

  @@index([bookingNumber])
  @@index([userId])
  @@index([listingId])
  @@index([departureId])
  @@index([status])
  @@index([startDate, endDate])
}

model Departure {
  id          String      @id @default(uuid())
  listingId   String
  listing     Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  seatsTotal  Int         @default(12)
  seatsLeft   Int         @default(12)
  price       Decimal?    @db.Decimal(10, 2)
  status      String      @default("AVAILABLE")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  bookings    Booking[]

  @@index([listingId, startDate])
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String        @unique
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("PKR")
  paymentMethod   PaymentMethod
  status          PaymentStatus @default(PENDING)
  transactionRef  String?       @unique
  rawResponse     Json?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([transactionRef])
  @@index([status])
}

model Payout {
  id            String       @id @default(uuid())
  vendorId      String
  vendor        Vendor       @relation(fields: [vendorId], references: [id])
  amount        Decimal      @db.Decimal(10, 2)
  status        PayoutStatus @default(PENDING)
  referenceCode String?
  notes         String?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([vendorId])
  @@index([status])
}

// --------------------------------------------------------
// REVIEWS, WISHLIST, COUPONS & NOTIFICATIONS
// --------------------------------------------------------

model Review {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String   @db.Text
  vendorReply String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, listingId])
  @@index([listingId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  discountPercent Int?
  flatDiscount    Decimal?  @db.Decimal(10, 2)
  minSpend        Decimal?  @db.Decimal(10, 2)
  validFrom       DateTime
  validUntil      DateTime
  maxUses         Int       @default(100)
  usedCount       Int       @default(0)
  isActive        Boolean   @default(true)
  bookings        Booking[]

  @@index([code])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([key])
}

model Enquiry {
  id              String   @id @default(uuid())
  destination     String
  travelDate      String?
  travelers       Int      @default(1)
  budgetRange     String?
  customerName    String
  customerPhone   String
  customerEmail   String?
  specialRequests String?  @db.Text
  status          String   @default("NEW")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model SupportTicket {
  id              String   @id @default(uuid())
  ticketNumber    String   @unique
  customerName    String
  customerContact String
  category        String   @default("GENERAL")
  message         String   @db.Text
  status          String   @default("OPEN")
  priority        String   @default("MEDIUM")
  adminNotes      String?  @db.Text
  source          String   @default("CHATBOT")
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([customerContact])
}

model ChatSession {
  id        String        @id @default(uuid())
  ipHash    String?
  language  String?       @default("en")
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([createdAt])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String      @db.Text
  createdAt DateTime    @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

// --------------------------------------------------------
// SECURITY & AUDIT LOGS (PHASE 3)
// --------------------------------------------------------

model LoginAttempt {
  id         String   @id @default(uuid())
  identifier String
  ip         String
  pairKey    String
  success    Boolean
  attemptAt  DateTime @default(now())

  @@index([pairKey, attemptAt])
  @@index([ip, attemptAt])
  @@index([attemptAt])
}

model BlockedLogin {
  id          String    @id @default(uuid())
  key         String    @unique
  type        String    // "PAIR" | "GLOBAL_IP"
  target      String    // email/phone or IP address
  ip          String
  reason      String
  blockedAt   DateTime  @default(now())
  expiresAt   DateTime
  unblockedAt DateTime?
  unblockedBy String?

  @@index([expiresAt])
  @@index([type])
  @@index([ip])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  actorEmail   String?
  action       String   // e.g., "LOGIN_FAILED", "LOGIN_BLOCKED", "LOGIN_UNBLOCKED", "ACCOUNT_LOCKED"
  resourceType String?  // e.g., "USER", "LOGIN_BLOCK", "IP"
  resourceId   String?
  details      String?  @db.Text
  ip           String?
  createdAt    DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([actorEmail])
}

model PasswordResetToken {
  id           String    @id @default(uuid())
  email        String
  codeHash     String    // SHA-256 hash of 6-digit code
  attemptsLeft Int       @default(5)
  expiresAt    DateTime
  usedAt       DateTime?
  invalidated  Boolean   @default(false)
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([email, expiresAt])
  @@index([createdAt])
}

model TwoFactorChallenge {
  id        String    @id @default(uuid())
  userId    String
  ticket    String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([ticket])
  @@index([userId])
}

// --------------------------------------------------------
// TRANSACTIONAL EMAIL OUTBOX
// --------------------------------------------------------

model EmailOutbox {
  id            String    @id @default(uuid())
  to            String
  recipientRole String    // "CUSTOMER" | "VENDOR" | "ADMIN"
  subject       String
  htmlBody      String    @db.Text
  textBody      String    @db.Text
  status        String    @default("PENDING") // PENDING | SENT | FAILED
  attempts      Int       @default(0)
  lastError     String?   @db.Text
  bookingId     String?
  eventType     String    // "BOOKING_CONFIRMED" | "BOOKING_CANCELLED" | "PAYMENT_RECEIVED"
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, attempts])
  @@index([bookingId])
  @@index([to])
  @@index([createdAt])
}



